        </div>

        <!-- Toggle button for mobile -->
        <button
          class="navbar-toggler d-lg-none"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarContent"
          aria-controls="navbarContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Center: Search bar and Right: Links (collapsible) -->
        <div class="collapse navbar-collapse" id="navbarContent">
          <div class="d-flex w-100 justify-content-between align-items-center">
            <!-- Center: Search bar -->
            <div class="mx-auto">
              <form class="d-flex" role="search" method="get" action="/result">
                <input
                  class="form-control me-2 search-input"
                  type="search"
                  name="query"
                  placeholder="Search"
                  aria-label="Search"
                  style="
                    width: 350px;
                    border-radius: 50px 0 0 50px;
                    padding: 10px 20px;
                    border: 1px solid #ccc;
                    outline: none;
                    transition: 0.3s;
                    border-color: #007bff; /* 👈 Focus effect */
                    box-shadow: 0 0 5px rgba(0, 123, 255, 0.4);
                  "
                />
                <button
                  style="
                    border-radius: 0 50px 50px 0;
                    background-color: #103051;
                    color: white;
                    border: none;
                    padding: 10px 25px;
                    transition: 0.3s;
                    background-color: #1d3e61;
                  "
                  class="btn search-btn"
                  type="submit"
                >
                  Search
                </button>
              </form>
            </div>

            <!-- Right: Links -->
            <nav class="d-flex align-items-center gap-3">
              <a href="#" class="text-decoration-none text-dark">About</a>
              <a href="#" class="text-decoration-none text-dark">Contact</a>
            </nav>
          </div>
        </div>
      </div>
    </header>

      <div class="container-book">
    <div class="book-header">
      <img src="<%= selectedBook.volumeInfo.imageLinks?.thumbnail || '/images/no-cover.png' %>"
           alt="<%= selectedBook.volumeInfo.title %> cover">

      <div class="book-info">
        <h2><%= selectedBook.volumeInfo.title %></h2>

        <% if (selectedBook.volumeInfo.subtitle) { %>
          <h4><%= selectedBook.volumeInfo.subtitle %></h4>
        <% } %>

        <div class="book-meta">
          <p><strong>Author:</strong> <%= selectedBook.volumeInfo.authors?.join(", ") || "Unknown" %></p>
          <p><strong>Publisher:</strong> <%= selectedBook.volumeInfo.publisher || "N/A" %></p>
          <p><strong>Published:</strong> <%= selectedBook.volumeInfo.publishedDate || "N/A" %></p>
          <p><strong>Pages:</strong> <%= selectedBook.volumeInfo.pageCount || "N/A" %></p>
          <p><strong>Category:</strong> <%= selectedBook.volumeInfo.categories?.join(", ") || "N/A" %></p>
          <p><strong>Rating:</strong> ⭐ <%= selectedBook.volumeInfo.averageRating || "—" %>
             (<%= selectedBook.volumeInfo.ratingsCount || 0 %> reviews)</p>
          <p><strong>Language:</strong> <%= selectedBook.volumeInfo.language?.toUpperCase() || "N/A" %></p>
        </div>
      </div>
    </div>

    <div class="book-desc">
      <h3>About this book</h3>
      <p><%= selectedBook.volumeInfo.description || "No description available." %></p>
    </div>

    <div class="links">
      <% if (selectedBook.volumeInfo.previewLink) { %>
        <a href="<%= selectedBook.volumeInfo.previewLink %>" target="_blank">📖 Preview</a>
      <% } %>
      <% if (selectedBook.volumeInfo.infoLink) { %>
        <a href="<%= selectedBook.volumeInfo.infoLink %>" target="_blank">🔗 More Info</a>
      <% } %>
    </div>
  </div>


